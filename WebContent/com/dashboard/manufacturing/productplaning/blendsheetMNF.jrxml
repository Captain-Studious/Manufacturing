	<subDataset name="Dataset1" uuid="52f975ac-a1cd-4d1e-8330-4b6de3e01fd1">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="MNFDriver"/>
		<parameter name="blendsheetno" class="java.lang.String"/>
		<queryString>
			<![CDATA[select @i:=@i+1 as slno,h.* from( select m.productname as item,stdper as per,qtykg,qty as qtyltr from my_blendsheet b left join my_main m on b.psrno=m.doc_no where b.doc_no=$P{blendsheetno})h,(select @i:=0)i]]>
		</queryString>
		<field name="slno" class="java.lang.String"/>
		<field name="item" class="java.lang.String"/>
		<field name="per" class="java.math.BigDecimal"/>
		<field name="qtykg" class="java.math.BigDecimal"/>
		<field name="qtyltr" class="java.math.BigDecimal"/>
		<variable name="sumper" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{per}]]></variableExpression>
		</variable>
		<variable name="sumqtykg" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{qtykg}]]></variableExpression>
		</variable>
		<variable name="sumqtyltr" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{qtyltr}]]></variableExpression>
		</variable>
	</subDataset>
	<subDataset name="Dataset2" uuid="47a8c5f2-4eb3-4be1-a2ba-bee65a51c579">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="MNFDriver"/>
		<queryString>
			<![CDATA[select 'drum' drum,'pail' pail,'carton' carton,'bulk' ibc]]>
		</queryString>
		<field name="drum" class="java.lang.String"/>
		<field name="pail" class="java.lang.String"/>
		<field name="carton" class="java.lang.String"/>
		<field name="ibc" class="java.lang.String"/>
