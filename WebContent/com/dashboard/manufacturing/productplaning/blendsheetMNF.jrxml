	<subDataset name="Dataset3" uuid="1b523edf-b01b-45d1-8556-84b8e9f8fc4f">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="MNFltst"/>
		<parameter name="sordoc" class="java.lang.String"/>
		<parameter name="psrno" class="java.lang.String"/>
		<queryString>
			<![CDATA[select sm.voc_no as sorno,m.productname,d.descptn,u.unit as productunit,d.qty from my_sorderm sm left join my_sorderd d on sm.doc_no=d.rdocno left join my_main m on d.psrno=m.doc_no left join my_unitm u on m.munit=u.doc_no where d.rdocno in($P{sordoc}) and d.psrno in($P{psrno})]]>
		</queryString>
		<field name="sorno" class="java.lang.String"/>
		<field name="productname" class="java.lang.String"/>
		<field name="descptn" class="java.lang.String"/>
		<field name="productunit" class="java.lang.String"/>
		<field name="qty" class="java.math.BigDecimal"/>
	</subDataset>
