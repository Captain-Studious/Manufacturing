		<queryString>
			<![CDATA[select m.test,m.method,u.unit,d.specification,d.testresult from my_prqualityd d left join my_prqualitym m on d.quality=m.qlno left join my_unitm u on m.unit=u.doc_no where m.status<>7 and d.orderno=$P{workno} and d.psrno=$P{psrno}]]>
