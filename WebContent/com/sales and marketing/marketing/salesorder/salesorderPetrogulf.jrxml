	<subDataset name="Dataset1" uuid="e61e0d7e-13ce-4c5f-b9af-f1068666b630">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="MNFltst"/>
		<parameter name="sordoc" class="java.lang.String"/>
		<queryString>
			<![CDATA[select @i:=@i+1 as srno,h.* from(Select m.productname,d.descptn as description, u.unit as produnit,round(d.qty,2) qty,round(d.amount,2) unitprice,round(d.discount,2) discount,round(d.total,2) amount from my_sorderd d left join my_main m on m.doc_no=d.prdId left join my_unitm u on d.unitid=u.doc_no    where d.rdocno=$P{sordoc})h,(select @i:=0)i]]>
		</queryString>
		<field name="srno" class="java.lang.String"/>
		<field name="productname" class="java.lang.String"/>
		<field name="description" class="java.lang.String"/>
		<field name="produnit" class="java.lang.String"/>
		<field name="qty" class="java.math.BigDecimal"/>
		<field name="unitprice" class="java.lang.String"/>
		<field name="discount" class="java.math.BigDecimal"/>
		<field name="amount" class="java.math.BigDecimal"/>
		<variable name="qtytotal" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{qty}]]></variableExpression>
		</variable>
		<variable name="amounttotal" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{amount}]]></variableExpression>
		</variable>
	</subDataset>
